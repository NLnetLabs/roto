fn get(x: List[u64], idx: u64) -> u64 {
    match x.get(idx) {
        Some(y) => y,
        None => 0,
    }
}

fn sort(x: List[u64]) -> List[u64] {
    let i = 1;
    while i < x.len() {
        let value = get(x, i);
        let j = i;
        while j > 0 && get(x, j - 1) > value {
            x.swap(j, j - 1);
            j -= 1;
        }
        i += 1;
    }
    x
}

fn main(x: List[u64]) -> List[u64] {
    sort(x)
}
