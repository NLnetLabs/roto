    deviate not-supported;
  }

  deviation "/rt:routing/ribs/rib/afi-safis/afi-safi/ipv4-unicast/routes/route/origin-as/eligible-prefix-policy" {
    deviate not-supported;
  }
  deviation "/rt:routing/ribs/rib/afi-safis/afi-safi/ipv6-unicast/routes/route/origin-as/eligible-prefix-policy" {
    deviate not-supported;
  }

  // interface

  deviation "/rt:routing/rt:interfaces" {
    deviate not-supported;
  }

  deviation "/if:interfaces-state" {
    deviate not-supported;
  }

  deviation "/if:interfaces/if:interface/if:statistics" {
    deviate not-supported;
  }

  typedef rib-type {
      type enumeration {
          enum "adj-rib-in-pre";
          enum "adj-rib-in-post";
          enum "loc-rib";
          enum "adj-rib-out-pre";
          enum "adj-rib-out-post";
      }
  }

  grouping route {
    leaf peer-id {
      type leafref {
        path "/rt:routing/"
           + "rt:control-plane-protocols/"
           + "rt:control-plane-protocol/bgp:bgp/"
           + "bgp:neighbors/bgp:neighbor/"
           + "bgp:remote-address";
      }
    }
    leaf rib-type {
        type rib-type;
    }
    uses bgp:bgp-loc-rib-common-keys;
    uses bgp:attr-set-attributes;
    uses bgp:bgp-unknown-attr-top;
    uses bgp:rib-ext-route-annotations;
    uses oav:origin-as-selection-option;
    leaf aspa-verifications-state {
      type aspa:aspa-verification-state;
      description
        "ASPA verification of BGP Unicast prefix.";
    }
    uses route-status;
  }

  typedef rotonda-custom-type {
    type enumeration {
      enum "rpki-vrp";
      enum "rpki-aspa";
      enum "roto-record";
    }
  }

  // Roto

  grouping roto-function {
    leaf roto-function {
      type leafref {
        path "/rt:routing/roto:roto/roto:deployments/roto:functions/roto:function/roto:locations/roto:location/roto:path"; } 
    }
  }

  augment "/rt:routing" {

    container ribs {
      config false;
      list rib {
        key "rib-id";
        leaf rib-id {
          type uint64;
          mandatory true;
        }
        container afi-safis {
          config false;
          list afi-safi {
            key "name";
            leaf name {
              type identityref {
                base bt:afi-safi-type;
              }
            }
            container ipv4-unicast {
              when "derived-from-or-self(../name, 'bt:ipv4-unicast')" {
                description
                  "Include this container for IPv4 unicast RIB.";
              }
              description
                "Routing tables for IPv4 unicast -- active when the
                 afi-safi name is ipv4-unicast.";
              uses roto-function;
              container routes {
                list route {
                  key "prefix peer-id rib-type path-id";
                  leaf prefix {
                    type inet:ipv4-prefix;
                  }
                  uses route;
                }
              }
            }
            container ipv6-unicast {
              when "derived-from-or-self(../name, 'bt:ipv6-unicast')" {
                description
                  "Include this container for IPv6 unicast RIB.";
              }
              description
                "Routing tables for IPv6 unicast -- active when the
                 afi-safi name is ipv4-unicast.";
              uses roto-function;
              container routes {
                list route {
                  key "prefix peer-id rib-type path-id";
                  leaf prefix {
                    type inet:ipv6-prefix;
                  }
                  uses route;
                }
              }
            }
          }
        }
        container custom-unicast-ribs {
          config false;
          list custom-unicast-rib {
            key "name";
            leaf name {
              type string;
            }
          }
          leaf value-type {
            type rotonda-custom-type;
            mandatory true;
          }
          container ipv4-unicast {
            list entry {
              key "prefix";
              leaf prefix {
                type inet:ipv4-prefix;
              }
              leaf value {
                type leafref { path "../../../value-type"; }
                mandatory true;
              }
              uses route-status;
            }
          }
          container ipv6-unicast {
            list entry {
              key "prefix";
              leaf prefix {
                type inet:ipv6-prefix;
              }
              leaf value {
                type leafref { path "../../../value-type"; }
                mandatory true;
              }
              uses route-status;
            }
          }
          uses roto-function;
        }
      }
    }
  }

  /* augment "/rt:routing/rt:control-plane-protocols/"
    + "rt:control-plane-protocol/bgp:bgp/bgp:global" {
      when "derived-from-or-self(rt:type, 'bgp')" {}
      uses roto-function;
  } */

  /* augment "/rt:routing/rt:control-plane-protocols/"
    + "rt:control-plane-protocol/bmp:bmp" {
      when "derived-from-or-self(rt:type, 'bmp')" {}
      uses roto-function;
  } */

  /* augment "/rt:routing/rt:control-plane-protocols/"
    + "rt:control-plane-protocol/rtr:rpki-rtr" {
      when "derived-from-or-self(rt:type, 'rpki-rtr')" {}
      uses roto-function;
  } */
}
