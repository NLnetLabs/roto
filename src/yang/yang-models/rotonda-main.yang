module rotonda-main {
    yang-version 1.1;
    namespace "urn:nlnetlabs:rotonda:main";
    prefix "rotonda";

    import ietf-yang-schema-mount {
        prefix yangmnt;
    }

  container "rotonda-root" {
    leaf rotonda-id {
      type uint8;
      mandatory true;
      config false;
    }
    
    yangmnt:mount-point "rotonda-root" {
      description
        "    Root \t \n    \"for\" \\logical network element\\" + " and some more shit";
    }
  }
}
