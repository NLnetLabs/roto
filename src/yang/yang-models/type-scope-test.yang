module type-scope-test {
  yang-version 1.1;
  namespace "urn:nlnetlabs:rotonda:conf";
  prefix "rotonda";

  //import ietf-yang-types {
  //   prefix yang;
  //}
  

  //import ietf-rpki-rtr {
  //   prefix rtr;
  //}

  import iana-ssh-public-key-algs {
    prefix sshpka;
  }

  typedef horror-show {
     type uint32;
  }

  container "rotonda-root" {
    typedef horror-show1.9 {
      type uint32;
    }

    leaf hs0 {
      type horror-show1.9;
    }
  }

  container "rotonda-non-root" {
    typedef horror-show2 {
      type uint64 {
        range "80..90 | 100..max" {
          description "blaffer";
        }
      }
    }
      
    //leaf rotor {
    //  type rtr:ipv4-pfx-len;
    //}
  }
}
